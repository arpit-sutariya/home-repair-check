# Optional. Without a key the app uses free local models (CLIP + a small text model).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limit checks per visitor (per 10 minutes) on a public deploy
RATE_LIMIT=20

# Optional. Real contractor listings with ratings, reviews and "open now" (Google Places API, New).
# Without it the app uses free OpenStreetMap listings, which are sparser.
GOOGLE_PLACES_API_KEY=
# OpenStreetMap's Nominatim asks apps to identify themselves; put your app name and a contact URL or email here.
CONTACT_USER_AGENT=
